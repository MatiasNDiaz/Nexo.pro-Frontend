# Variables públicas del frontend. Todas terminan dentro del JavaScript del navegador:
# acá nunca va un secreto. Copiar a .env.local para desarrollo.

# Origen de la API (sin /api/v1 ni barra final). En producción: el mismo sitio que el frontend
# (p. ej. https://api.dominio.com con el frontend en https://dominio.com): las cookies son SameSite=Lax.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origen público de este frontend (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave PÚBLICA del widget de Cloudflare Turnstile (la secreta vive solo en el backend). Opcional.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# "true" si el backend tiene el login con Google activado (GOOGLE_PROVIDER distinto de disabled).
NEXT_PUBLIC_GOOGLE_LOGIN=false
